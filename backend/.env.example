# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Gemini
GEMINI_API_KEY=replace-with-your-gemini-key

# Database (blank uses local SQLite)
DATABASE_URL=

# Frontend security
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Ollama
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
OLLAMA_MODEL=qwen3:4b

# IndicTrans
TRANSLATION_API_URL=http://127.0.0.1:8003/translate

# Supabase private storage
SUPABASE_IMAGE_BUCKET=memory-images
SUPABASE_AUDIO_BUCKET=memory-audio

MEDIA_STORAGE_BACKEND=local
