# =========================
# PYTHON / BACKEND
# =========================

# Virtual environments
backend/.venv/
backend/venv/
backend/env/
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# =========================
# ENV / SECRETS
# =========================

.env
.env.*
!.env.example

backend/.env
backend/.env.*
!backend/.env.example

frontend/.env
frontend/.env.*
!frontend/.env.example

# =========================
# DATABASE / LOCAL STORAGE
# =========================

*.db
*.sqlite
*.sqlite3

backend/storage/uploads/*
backend/storage/memory_images/*
backend/storage/audio/*

# Keep storage folders
!backend/storage/uploads/.gitkeep
!backend/storage/memory_images/.gitkeep
!backend/storage/audio/.gitkeep

# =========================
# NODE / REACT / VITE
# =========================

node_modules/
frontend/node_modules/

dist/
frontend/dist/

.vite/
frontend/.vite/

# =========================
# LOGS
# =========================

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# EDITOR
# =========================

.vscode/
.idea/

# =========================
# OS FILES
# =========================

.DS_Store
Thumbs.db
desktop.ini

# =========================
# TEMPORARY FILES
# =========================

*.tmp
*.temp
*.swp
*.swo